<resources>
    <style name="Theme.ShahMatI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/dark_square</item>
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.ShahMatI.Splash" parent="Theme.ShahMatI">
        <item name="android:windowBackground">@color/dark_square</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <style name="RoundedButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="DonateButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="backgroundTint">#6A1B9A</item>
    </style>
</resources>