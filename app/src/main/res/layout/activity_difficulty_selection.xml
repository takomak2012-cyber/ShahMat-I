<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_difficulty_background">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_chess_fade" />

    <ScrollView
        android:id="@+id/difficultyScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/difficultySelectRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="126dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <View
                    android:layout_width="78dp"
                    android:layout_height="1dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_header_line" />
                <ImageView
                    android:id="@+id/icHeaderCrown"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_chess_crown"
                    android:tint="@color/gold_accent"
                    android:contentDescription="@string/difficulty_header_choose" />
                <View
                    android:layout_width="78dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_header_line" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/difficulty_header_choose"
                android:textSize="30sp"
                android:textStyle="bold"
                android:typeface="serif"
                android:textColor="#2E1F12"
                android:layout_marginTop="6dp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/difficulty_header_level"
                android:textSize="19sp"
                android:typeface="serif"
                android:textColor="#3B2A1A"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="18dp"
                android:orientation="horizontal">
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_header_line" />
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_gold_diamond"
                    android:contentDescription="@string/difficulty_header_choose" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_header_line" />
            </LinearLayout>

            <include layout="@layout/item_difficulty_learn" />
            <include layout="@layout/item_difficulty_beginner" />
            <include layout="@layout/item_difficulty_intermediate" />
            <include layout="@layout/item_difficulty_master" />
            <include layout="@layout/item_difficulty_two_player" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_info_banner"
                android:padding="14dp"
                android:layout_marginTop="2dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_card_icon_light">
                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chess_crown"
                        android:tint="#2E1F12"
                        android:contentDescription="@string/difficulty_banner_title" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/difficulty_banner_title"
                    android:textSize="13sp"
                    android:textColor="#2E1F12"
                    android:maxLines="3" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:background="#EAF0E5DA">

        <LinearLayout
            android:id="@+id/btnDifficultyBack"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_back_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/difficulty_back">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_back"
                android:tint="#FFFFFF"
                android:contentDescription="@string/difficulty_back" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/difficulty_back"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvDifficultyVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#4A3B28"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>
</FrameLayout>
