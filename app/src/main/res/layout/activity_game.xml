<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_square">

    <TextView
        android:id="@+id/tvDifficulty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/choose_difficulty"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/dark_square"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.shahmat.game.ui.game.ChessBoardView
        android:id="@+id/chessBoardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvDifficulty"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/tvVersion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/gameControlButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnSurrender"
                style="@style/RoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="6dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/btn_surrender"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="15sp"
                app:autoSizeStepGranularity="1sp"
                android:backgroundTint="@color/btn_primary"
                android:textColor="@color/btn_text" />

            <Button
                android:id="@+id/btnHint"
                style="@style/RoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="6dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/btn_hint"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="15sp"
                app:autoSizeStepGranularity="1sp"
                android:backgroundTint="@color/btn_secondary"
                android:textColor="@color/btn_text" />

            <Button
                android:id="@+id/btnAsk"
                style="@style/RoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="6dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/btn_ask"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="15sp"
                app:autoSizeStepGranularity="1sp"
                android:backgroundTint="@color/btn_secondary"
                android:textColor="@color/btn_text" />

            <Button
                android:id="@+id/btnMinimize"
                style="@style/RoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="6dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/btn_minimize"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeMaxTextSize="15sp"
                app:autoSizeStepGranularity="1sp"
                android:backgroundTint="@color/btn_secondary"
                android:textColor="@color/btn_text" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDonate"
            style="@style/DonateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/btn_donate"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="13sp"
            app:autoSizeMaxTextSize="16sp"
            app:autoSizeStepGranularity="1sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvTurnIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/your_turn"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:padding="12dp"
        android:background="@color/white"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/chessBoardView"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- App version shown at the very bottom. The text is set at runtime from
         BuildConfig.VERSION_NAME, so it updates automatically when versionName is
         changed in Gradle. Its bottom inset follows the system navigation area. -->
    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:textSize="12sp"
        android:textColor="@color/gray_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>