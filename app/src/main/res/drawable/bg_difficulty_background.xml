<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Warm sepia/beige base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E9DECB"
                android:centerColor="#DAC9A8"
                android:endColor="#C7B28B"
                android:angle="270" />
        </shape>
    </item>
    <!-- Faint blurred chess board (soft warm tint) -->
    <item android:drawable="@drawable/chess_board_pattern" android:alpha="0.05" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#DDF1E6D3" />
        </shape>
    </item>
</layer-list>
